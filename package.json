{
  "name": "gitmindhub",
  "version": "1.0.0",
  "main": "main.mjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "NODE_ENV=development electron .",
    "build:vite": "vite build",
    "build:electron": "electron-builder --publish never",
    "build": "npm run build:vite && npm run build:electron",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.gitmindhub.app",
    "productName": "GitMindHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.mjs",
      "preload.js",
      "package.json",
      "src/*",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@lancedb/lancedb": "^0.38.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reactflow": "^11.11.4",
    "uuid": "^14.0.2"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-x64": "^0.22.3"
  }
}
